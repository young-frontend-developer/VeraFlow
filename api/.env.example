# float32, not bfloat16: bf16 is software-emulated on x86 CPUs without an
# AVX512-BF16 path, measured at 19.68s vs 1.33s for byte-identical output.
TILAWAH_MODEL_DTYPE=float32
TILAWAH_MODEL_DEVICE=cpu
TILAWAH_DATABASE_URL=sqlite:///./tilawah.db
# TILAWAH_DATABASE_URL=postgresql+psycopg://postgres:PASS@db.PROJECT.supabase.co:5432/postgres
TILAWAH_CORS_ORIGINS=http://localhost:5173
TILAWAH_STORE_AUDIO=0

# Save every uploaded recording + its measurements to api/debug_audio/ and log a
# line of real numbers per attempt. On by default in development because browser
# attempts are otherwise never persisted (the DB only keeps them once the learner
# consents), which makes "recording never works" impossible to diagnose.
# Turn OFF for anything real: it stores raw voice indefinitely.
TILAWAH_DEBUG_AUDIO=1
# TILAWAH_DEBUG_DIR=/var/tmp/tilawah-debug

# Bypass the content review gate: render EVERY detected error, including codes
# no qori has reviewed and codes with no authored text at all, and lift the
# two-error display cap. Each one arrives marked `draft` and the UI shows a
# hatched banner plus a DRAFT chip per card.
#
# This is how you inspect what the engine actually detects WITHOUT flipping
# `reviewed` in content/rules.json — that flag is the real safety gate and must
# never be loosened for convenience.
#
# Off by default. The API refuses to start with this on when TILAWAH_ENV is
# production, exactly like TILAWAH_DEBUG_AUDIO.
TILAWAH_SHOW_UNREVIEWED=0

# dev | production. Set to production and the two diagnostics above become
# hard boot failures rather than warnings.
TILAWAH_ENV=dev
