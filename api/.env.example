# float32, not bfloat16: bf16 is software-emulated on x86 CPUs without an
# AVX512-BF16 path, measured at 19.68s vs 1.33s for byte-identical output.
TILAWAH_MODEL_DTYPE=float32
TILAWAH_MODEL_DEVICE=cpu
TILAWAH_DATABASE_URL=sqlite:///./tilawah.db
# TILAWAH_DATABASE_URL=postgresql+psycopg://postgres:PASS@db.PROJECT.supabase.co:5432/postgres
TILAWAH_CORS_ORIGINS=http://localhost:5173
TILAWAH_STORE_AUDIO=0

# Longest recitation the engine will attempt, in seconds. A MEMORY limit and a
# quadratic one: wav2vec2-BERT relative-position attention allocates
# (47 * seconds)^2 * 256 bytes. Measured on 8 GB float32 CPU —
#   52 s -> 1.5 GB, ran in 522 s (~10x realtime)
#  129 s -> 9.4 GB, DefaultCPUAllocator OOM
# 90 s covers 99.0% of the Quran recited whole; longer ayat use the in-app
# "practise part of this ayah" control. Raise it on a bigger box using the
# formula above.
TILAWAH_MAX_AUDIO_SECONDS=90

# Save every uploaded recording + its measurements to api/debug_audio/ and log a
# line of real numbers per attempt. On by default in development because browser
# attempts are otherwise never persisted (the DB only keeps them once the learner
# consents), which makes "recording never works" impossible to diagnose.
# Turn OFF for anything real: it stores raw voice indefinitely.
TILAWAH_DEBUG_AUDIO=1
# TILAWAH_DEBUG_DIR=/var/tmp/tilawah-debug

# dev | production.
#
# THIS ALSO CONTROLS THE CONTENT REVIEW GATE. There used to be a separate
# TILAWAH_SHOW_UNREVIEWED flag, off by default, and the result was that the
# default build showed a learner only the 2 of 11 authored codes a qori had
# signed off — three real mistakes surfaced as one, or as "couldn't fully
# assess". An opt-in flag was the wrong shape for something you want on for
# every development run, so the polarity is inverted and the flag is gone:
#
#   dev         every detected error is rendered, including unreviewed codes
#               and codes with no authored text, uncapped. Each arrives marked
#               `draft`; the UI shows a banner plus a DRAFT chip per card.
#   production  only corrections a qori has reviewed reach the learner.
#
# `reviewed` in content/rules.json is still the real signal and must never be
# loosened for convenience. What changed is who the gate protects: a learner,
# not the person building the thing.
#
# TILAWAH_DEBUG_AUDIO above remains a hard boot failure under production.
TILAWAH_ENV=dev
