# float32, not bfloat16: bf16 is software-emulated on x86 CPUs without an
# AVX512-BF16 path, measured at 19.68s vs 1.33s for byte-identical output.
TILAWAH_MODEL_DTYPE=float32
TILAWAH_MODEL_DEVICE=cpu
TILAWAH_DATABASE_URL=sqlite:///./tilawah.db
# TILAWAH_DATABASE_URL=postgresql+psycopg://postgres:PASS@db.PROJECT.supabase.co:5432/postgres
TILAWAH_CORS_ORIGINS=http://localhost:5173
TILAWAH_STORE_AUDIO=0

# Longest recitation the engine will attempt, in seconds. A MEMORY limit and a
# quadratic one: wav2vec2-BERT relative-position attention allocates
# (47 * seconds)^2 * 256 bytes. Measured on 8 GB float32 CPU —
#   52 s -> 1.5 GB, ran in 522 s (~10x realtime)
#  129 s -> 9.4 GB, DefaultCPUAllocator OOM
# 90 s covers 99.0% of the Quran recited whole; longer ayat use the in-app
# "practise part of this ayah" control. Raise it on a bigger box using the
# formula above.
TILAWAH_MAX_AUDIO_SECONDS=90

# Save every uploaded recording + its measurements to api/debug_audio/ and log a
# line of real numbers per attempt. On by default in development because browser
# attempts are otherwise never persisted (the DB only keeps them once the learner
# consents), which makes "recording never works" impossible to diagnose.
# Turn OFF for anything real: it stores raw voice indefinitely.
TILAWAH_DEBUG_AUDIO=1
# TILAWAH_DEBUG_DIR=/var/tmp/tilawah-debug

# dev | production.
#
# THIS ALSO CONTROLS THE CONTENT REVIEW GATE. There used to be a separate
# TILAWAH_SHOW_UNREVIEWED flag, off by default, and the result was that the
# default build showed a learner only the 2 of 11 authored codes a qori had
# signed off — three real mistakes surfaced as one, or as "couldn't fully
# assess". An opt-in flag was the wrong shape for something you want on for
# every development run, so the polarity is inverted and the flag is gone:
#
#   dev         every detected error is rendered, including unreviewed codes
#               and codes with no authored text, uncapped. Each arrives marked
#               `draft`; the UI shows a banner plus a DRAFT chip per card.
#   production  only corrections a qori has reviewed reach the learner.
#
# `reviewed` in content/rules.json is still the real signal and must never be
# loosened for convenience. What changed is who the gate protects: a learner,
# not the person building the thing.
#
# TILAWAH_DEBUG_AUDIO above remains a hard boot failure under production.
TILAWAH_ENV=dev

# ── sessions ────────────────────────────────────────────────────────────────
# Opaque, revocable session tokens. Only a sha256 of each token is stored.
TILAWAH_SESSION_TTL_DAYS=30
TILAWAH_SESSION_COOKIE=tilawah_session

# PRODUCTION REQUIRES BOTH OF THE NEXT TWO. main.py refuses to boot otherwise.
#
#   TILAWAH_SESSION_COOKIE_SECURE=1
#     Without it the session cookie is sent over plain http and the token is
#     readable by anyone on the network path. Off here only because dev is http.
#
#   TILAWAH_SESSION_COOKIE_SAMESITE
#     lax     same-origin deployment (api and client behind one hostname).
#             The default, and the only CSRF protection currently in place -
#             the browser will not attach the cookie to a cross-site POST.
#     none    split-origin deployment (api on its own hostname). REQUIRES
#             SECURE=1, and means CSRF protection must come from somewhere
#             else before any state-changing route moves behind the session.
#     strict  safe, but drops the cookie on inbound links; rarely what you want.
#
# NOTE FOR DEV: the client on :5173 talking to the api on :8000 is CROSS-SITE,
# so the browser will not send a `lax` cookie there at all. Dev uses the bearer
# header instead - same session, different transport.
TILAWAH_SESSION_COOKIE_SECURE=0
TILAWAH_SESSION_COOKIE_SAMESITE=lax

# ── the device-claim window: TEMPORARY, CLOSE IT ────────────────────────────
#
# Lets POST /api/auth/anonymous trade an existing device_id for a session, so
# installs that predate accounts keep their practice history.
#
# THIS IS NOT AN AUTHENTICATION MECHANISM AND MUST NEVER BECOME ONE. A device
# id proves nothing - they have been travelling in query strings into access
# logs, browser history and every proxy since the first release. Anyone holding
# a harvested one can claim that learner's history while this is open. It is
# tolerable only because the same id is ALREADY full authority on /api/attempts
# and /api/consent today, and because it ends.
#
# LIFECYCLE
#   1. open during the migration, with a deadline
#   2. once existing installs have sessions: TILAWAH_ALLOW_DEVICE_CLAIM=0
#   3. before public authentication launch: it MUST be 0
#
# Two things stop "temporary" drifting into "permanent":
#   * production refuses to boot with claiming on and no deadline set
#   * past the deadline the endpoint stops claiming on its own, no deploy needed
#
# Closed, the endpoint answers 410 - never a silent new account, which would
# read to the learner as their practice having vanished.
TILAWAH_ALLOW_DEVICE_CLAIM=1
# ISO date, the last day claiming works. Mandatory in production when the
# window is open. e.g. TILAWAH_DEVICE_CLAIM_UNTIL=2026-09-30
TILAWAH_DEVICE_CLAIM_UNTIL=

# ── Google sign-in ──────────────────────────────────────────────────────────
#
# EMPTY MEANS OFF, and off is a real state: /api/auth/google* answer 503 and
# the sign-in screen keeps its disabled Google button and its honest line,
# rather than showing a control that cannot work.
#
# A COMMA-SEPARATED LIST, not one value. The `aud` claim carries whichever
# OAuth client obtained the token and a project has several. The trap worth
# knowing before you build the Android app: Android's Credential Manager
# returns a token whose `aud` is the WEB/server client id, not the Android
# one - so both belong here and a single hardcoded value will reject one
# platform with nothing but "wrong audience" to go on.
#
#   TILAWAH_GOOGLE_CLIENT_IDS=123-web.apps.googleusercontent.com,123-android.apps.googleusercontent.com
TILAWAH_GOOGLE_CLIENT_IDS=

# Lifetime of a login nonce, in seconds. The nonce is single-use and is what
# stops login CSRF - an attacker pushing THEIR Google credential into your
# browser so your recitations land in their account. Short is correct: it is
# spent seconds after being issued, and the client re-arms it automatically.
TILAWAH_GOOGLE_NONCE_TTL_SECONDS=300

# NOTE: there is NO client secret and NO redirect uri. This is the ID-token
# flow: the browser gets a signed token from Google and posts it here, and the
# server verifies the signature against Google's public keys. Nothing secret
# reaches the frontend, no provider token is ever stored, and the same endpoint
# will serve the Android app unchanged.
#
# The frontend needs no Google variable either - it reads the client id from
# /api/auth/google/start, so there is exactly one place to configure it.
